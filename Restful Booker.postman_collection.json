    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('bookingid is present', () => pm.expect(json.bookingid).to.be.a('number'));",
              "pm.collectionVariables.set('bookingid', json.bookingid);",
              "pm.test('firstname is Jim', () => pm.expect(json.booking.firstname).to.eql('Jim'));",
              "pm.test('lastname is Brown', () => pm.expect(json.booking.lastname).to.eql('Brown'));",
              "pm.test('totalprice is 111', () => pm.expect(json.booking.totalprice).to.eql(111));",
              "pm.test('depositpaid is true', () => pm.expect(json.booking.depositpaid).to.eql(true));",
              "pm.test('checkin date is correct', () => pm.expect(json.booking.bookingdates.checkin).to.eql('2018-01-01'));",
              "pm.test('checkout date is correct', () => pm.expect(json.booking.bookingdates.checkout).to.eql('2019-01-01'));",
              "pm.test('additionalneeds is Breakfast', () => pm.expect(json.booking.additionalneeds).to.eql('Breakfast'));"
            ]
          }
        }
      ],
